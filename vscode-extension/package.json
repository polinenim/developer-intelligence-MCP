{
  "name": "developer-intelligence-mcp-vscode",
  "displayName": "Developer Intelligence MCP",
  "publisher": "local",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onCommand:developerIntelligence.askQuestion",
    "onView:developerIntelligence.askView"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "developerIntelligence.askQuestion",
        "title": "Developer Intelligence: Ask Question"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "developerIntelligence",
          "title": "Developer Intelligence",
          "icon": "./resources/icon.svg"
        }
      ]
    },
    "views": {
      "developerIntelligence": [
        {
          "id": "developerIntelligence.askView",
          "name": "Ask Question",
          "type": "webview",
          "icon": "./resources/icon.svg"
        }
      ]
    }
  }
}